{
  "name": "@happycastle/steel-managed-manager",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.23.1"
  },
  "bin": {
    "steel-managed-manager": "build/cli.js",
    "steel-manager-healthcheck": "build/healthcheck-cli.js"
  },
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js"
    }
  },
  "scripts": {
    "prebuild": "npm run build -w @happycastle/steel-managed-shared -w @happycastle/steel-managed-gateway",
    "build": "tsc --project tsconfig.json",
    "pretest": "npm run build -w @happycastle/steel-managed-shared -w @happycastle/steel-managed-gateway",
    "test": "vitest run && cargo test --manifest-path init/Cargo.toml",
    "test:unit": "vitest run && cargo test --manifest-path init/Cargo.toml",
    "test:image-policy": "vitest run test/image-policy.test.ts test/dockerfile-policy.test.ts",
    "pretypecheck": "npm run build -w @happycastle/steel-managed-shared -w @happycastle/steel-managed-gateway",
    "typecheck": "tsc --noEmit --project tsconfig.json && tsc --noEmit --project tsconfig.test.json"
  },
  "dependencies": {
    "@happycastle/steel-managed-gateway": "0.0.0",
    "@happycastle/steel-managed-shared": "0.0.0",
    "fastify": "5.10.0",
    "jose": "6.2.3",
    "undici": "7.28.0",
    "ws": "8.21.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.14.1",
    "@types/ws": "8.18.1",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
