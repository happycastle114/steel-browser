{
  "schemaVersion": 1,
  "license": "Apache-2.0",
  "repository": "https://github.com/happycastle114/steel-browser",
  "sourceRevisionProof": "OCI_REVISION_AND_RUNTIME_SOURCE_MANIFEST",
  "baseImageReceipt": "base-images.lock.json",
  "build": {
    "method": "GIT_ARCHIVE_TWO_ATTEMPT_REGISTRY_READBACK",
    "script": "managed/manager/image/build-reproducible.sh",
    "auditReceiptProof": "OCI_LABEL_AND_RUNTIME_SHA256"
  },
  "console": {
    "root": "/srv/steel-console",
    "manifest": "/srv/steel-console/asset-manifest.json",
    "proof": "STARTUP_SHA256_READBACK"
  },
  "runtime": {
    "nodeVersion": "22.23.1",
    "rustVersion": "1.91.1",
    "init": "/usr/local/bin/steel-manager-init",
    "manager": "/usr/local/bin/steel-managed-manager",
    "healthcheck": "/usr/local/bin/steel-manager-healthcheck",
    "productionAuditReceipt": "/app/managed/production-dependency-audit.json",
    "runtimeSourceManifest": "/licenses/steel-manager/runtime-source-manifest.json",
    "releaseEvidence": {
      "mode": "CONFIG_FILE",
      "source": "/run/steel-release-evidence-source/release-evidence.json",
      "target": "/run/steel/managed-release-evidence.json"
    }
  }
}
