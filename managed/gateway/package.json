{
  "name": "@happycastle/steel-managed-gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js"
    }
  },
  "scripts": {
    "prebuild": "npm run build -w @happycastle/steel-managed-shared",
    "precheck:managed-api-drift": "npm run build -w @happycastle/steel-managed-shared",
    "pretest": "npm run build -w @happycastle/steel-managed-shared",
    "pretypecheck": "npm run build -w @happycastle/steel-managed-shared",
    "build": "tsc --project tsconfig.json",
    "check:managed-api-drift": "tsx src/api/operations/generate-artifacts-cli.ts check",
    "generate:managed-api": "tsx src/api/operations/generate-artifacts-cli.ts write",
    "check:ai-artifacts": "tsx src/api/managed/generate-artifacts-cli.ts check",
    "generate:ai-artifacts": "tsx src/api/managed/generate-artifacts-cli.ts write",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --project tsconfig.json && tsc --noEmit --project tsconfig.test.json"
  },
  "dependencies": {
    "@happycastle/steel-managed-shared": "0.0.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "fastify": "5.8.5",
    "undici": "7.28.0",
    "ws": "8.21.1",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.24.6"
  },
  "devDependencies": {
    "@types/node": "22.14.1",
    "@types/ws": "8.18.1",
    "tsx": "4.19.2",
    "typescript": "5.9.2",
    "vitest": "3.2.6"
  }
}
