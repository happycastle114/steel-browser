{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "steel_managed": {
      "type": "remote",
      "url": "https://steel.soungmin.tech/mcp",
      "enabled": true,
      "oauth": false,
      "headers": {
        "CF-Access-Client-Id": "{env:STEEL_CF_ACCESS_CLIENT_ID}",
        "CF-Access-Client-Secret": "{env:STEEL_CF_ACCESS_CLIENT_SECRET}"
      },
      "timeout": 75000
    }
  }
}
